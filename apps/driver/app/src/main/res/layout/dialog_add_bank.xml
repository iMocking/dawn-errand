<?xml version="1.0" encoding="utf-8"?>
<!-- 添加银行卡弹窗：输入框样式对齐登录页（label + 透明底下划线输入行） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="4dp"
    android:paddingRight="20dp"
    android:paddingBottom="4dp">

    <!-- 持卡人姓名 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wallet_dialog_holder"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:hint="请输入持卡人姓名"
        android:inputType="text"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_faint"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 银行卡号 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wallet_dialog_cardno"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etCardNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:hint="请输入银行卡号"
        android:inputType="number"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_faint"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 开户银行 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wallet_dialog_bank"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:hint="请输入开户银行"
        android:inputType="text"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_faint"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 有效期 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="有效期（MM/YY）"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:hint="如 08/28"
        android:inputType="text"
        android:maxLength="5"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_faint"
        android:textSize="16sp" />
</LinearLayout>
