<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DriverApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DawnDriver"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.screens.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.screens.main.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.orderdetail.OrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.navigation.NavigationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.checkin.CheckinActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.finance.FinanceActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.cardwallet.CardWalletActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.support.SupportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.settings.SettingsActivity"
            android:exported="false" />
    </application>

</manifest>
