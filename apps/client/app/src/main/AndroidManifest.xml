<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 高德地图/定位 SDK -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

    <application
        android:name=".ClientApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DawnClient"
        android:usesCleartextTraffic="true">

        <!-- 高德开放平台 Key（构建时由 -PamapKey 注入 manifestPlaceholders） -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${amapKey}" />

        <!-- 高德定位 SDK 后台定位服务（合包为普通 jar 无自带 manifest，需手动声明） -->
        <service android:name="com.amap.api.location.APSService" />

        <activity
            android:name=".ui.screens.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DawnClient">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.screens.login.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.main.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.errand.ErrandActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.orders.OrdersActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.search.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.merchant.MerchantDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.orderconfirm.OrderConfirmActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.paysuccess.PaySuccessActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.ordertrack.OrderTrackActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.review.ReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.address.AddressActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.addressedit.AddressEditActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.coupons.CouponsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.orderdetail.OrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.editor.ProfileEditActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.help.HelpCenterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.customer.CustomerServiceActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.join.JoinActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.legal.LegalActivity"
            android:exported="false" />
    </application>
</manifest>
