# ===== 本地开发环境变量（已被 .gitignore 忽略，勿提交）=====
# 仅用于本地开发/测试；生产环境通过密钥管理系统注入，禁止复用本文件密码。

# 服务监听
APP_ENV=dev
HTTP_PORT=8080

# PostgreSQL（与 docker-compose.yml 保持一致）
POSTGRES_DSN=host=localhost port=5432 user=dawn password=dawn_dev_only dbname=dawn_errand sslmode=disable TimeZone=UTC

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=dawn_dev_only

# JWT 与令牌
JWT_SECRET=dev_only_jwt_secret_change_me_0123456789abcdef
ACCESS_TOKEN_TTL=900            # 秒，15 分钟
REFRESH_TOKEN_TTL=1209600       # 秒，14 天

# 配置加密密钥（AES-256-GCM，用于加密 SMTP/OSS 等敏感配置项）
CONFIG_ENCRYPTION_KEY=dev_only_config_key_0123456789abcdef0123456789

# 初始化令牌（POST /system/bootstrap 需要，生产必须更换）
BOOTSTRAP_TOKEN=dev_bootstrap_token_2026

# 指标抓取令牌（GET /metrics 需带 X-Metrics-Token）
# 留空：prod 关闭 /metrics，非 prod 放行便于本机调试；生产建议配随机值并只对内网暴露
METRICS_TOKEN=

# 存储（本地存储实现）
STORAGE_ROOT_DIR=.data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080
STORAGE_MAX_SIZE_MB=10

# 可信反向代理网段（逗号分隔 CIDR；仅这些来源的 X-Forwarded-For 会被采信，防伪造绕过 IP 限流）
# 部署在 Nginx/SLB 之后时改为代理实际网段，如 10.0.0.0/8；"*" 表示信任全部（仅调试用）
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# 订单超时任务（秒）
ORDER_PAY_TIMEOUT_SEC=900          # 待支付超时自动取消（15 分钟）
ORDER_AUTO_CONFIRM_SEC=86400       # 送达后自动确认收货（24 小时）

# 支付回调签名密钥（HMAC-SHA256，生产必须更换）
PAYMENT_CALLBACK_SECRET=dev_payment_callback_secret
